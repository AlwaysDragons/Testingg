# --- Core ---
ENV=production
LOG_LEVEL=INFO
TZ=America/Chicago

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ds:CHANGE_ME@db:5432/dropship_mp
DATABASE_URL_SYNC=postgresql+psycopg2://ds:CHANGE_ME@db:5432/dropship_mp
POSTGRES_USER=ds
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dropship_mp
REDIS_URL=redis://redis:6379/0

# --- Marketplaces (one session file per rotation account) ---
DEPOP_SESSION_DIR=/data/sessions/depop/
GRAILED_SESSION_DIR=/data/sessions/grailed/
MERCARI_SESSION_DIR=/data/sessions/mercari/

# --- Suppliers ---
DHGATE_SESSION_FILE=/data/sessions/dhgate.json
HOOBUY_SESSION_FILE=/data/sessions/hoobuy.json
KAKOBUY_SESSION_FILE=/data/sessions/kakobuy.json

# --- Reshipper ---
RESHIPPER=shipito
SHIPITO_API_KEY=
SHIPITO_ACCOUNT_ID=

# --- Proxy pool ---
PROXY_PROVIDER=brightdata
PROXY_HOST=brd.superproxy.io
PROXY_PORT=22225
PROXY_USER=
PROXY_PASS=
PROXY_SLOTS=5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# --- Scheduling ---
POLL_SOLD_INTERVAL_MINUTES=10
SCRAPE_INTERVAL_HOURS=6
HEALTH_CHECK_INTERVAL_HOURS=24
TRACKING_POLL_INTERVAL_MINUTES=30
REPRICE_INTERVAL_HOURS=24
COMPETITOR_WATCH_INTERVAL_HOURS=4
DM_POLL_INTERVAL_MINUTES=5
REVIEW_SOLICIT_DELAY_DAYS=3
DAILY_DIGEST_HOUR=8

# --- Limits ---
MAX_LISTINGS_PER_ACCOUNT_PER_DAY=5
MAX_SIMULTANEOUS_BROWSERS=3
WARMING_PERIOD_DAYS=7
WARMING_ACTIONS_PER_DAY=3
PRICE_BREACH_THRESHOLD_PCT=15
REPRICE_FLOOR_MARGIN_PCT=60
